# LLM Provider Configuration
# Supported providers: 'gemini' or 'openai-compatible'
LLM_PROVIDER=gemini

# Secret API key for Google Gemini (kept server-side only; never exposed to browser)
# Obtain a key at: https://aistudio.google.com/app/apikey
LLM_API_KEY=

# Model to use (fallback: gemini-3.8-flash)
LLM_MODEL=gemini-3.8-flash

# Optional base URL
LLM_BASE_URL=
