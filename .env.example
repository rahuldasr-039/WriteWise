# LLM Provider Configuration
# Supported providers: 'anthropic' or 'openai-compatible'
LLM_PROVIDER=anthropic

# API key for the selected provider (kept server-side only; never exposed to browser)
LLM_API_KEY=

# Model to use
# Default for Anthropic: claude-haiku-4-5-20251001 (or claude-3-5-haiku-20241022)
# For OpenAI-compatible / Groq: llama-3.3-70b-versatile or gpt-4o-mini
LLM_MODEL=claude-haiku-4-5-20251001

# Optional base URL for OpenAI-compatible providers (e.g. https://api.groq.com/openai/v1)
LLM_BASE_URL=
